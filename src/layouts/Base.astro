---
import '../styles/global.css';
import HunterAvatar from '../components/HunterAvatar.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Metadatos para el preview al pegar el enlace en WhatsApp o Discord. */
  ogTitle?: string;
  ogDescription?: string;
  noIndex?: boolean;
}

const { title, description, ogTitle, ogDescription, noIndex } = Astro.props;
const user = Astro.locals.user;
const t = Astro.locals.t;
const path = Astro.url.pathname;

const nav = [
  { href: '/inventario', label: t('nav.inventory') },
  { href: '/armador', label: t('nav.builder') },
  { href: '/mis-sets', label: t('nav.mySets') },
  { href: '/monstruos', label: t('monsters.title') },
  { href: '/coronas', label: t('nav.crowns') },
  { href: '/cazadores', label: t('nav.hunters') },
];
---

<!doctype html>
<html lang={Astro.locals.locale}>
  <head>
    <meta charset="utf-8" />
    {/* Antes del CSS: si se aplicara después, la página parpadearía en claro
        durante un fotograma para quien tiene el oscuro elegido. */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Spectral:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description ?? ''} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('app.name')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen flex flex-col">
    {/* 48 px fijos y cristal: es la única superficie translúcida junto al panel
        del armador y los diálogos. El desenfoque nunca baja a las filas. */}
    {/* 48 px con cristal. El rombo y el logotipo condensado son el registro de
        menú; la sección activa va en caja biselada, no en relleno plano. */}
    <header
      class="sticky top-0 z-40 border-b border-line"
      style="background: var(--panel-glass); backdrop-filter: blur(var(--panel-blur))"
    >
      <div class="mx-auto flex h-12 max-w-[1360px] items-center gap-1 px-4">
        <a href="/" class="mr-3 flex shrink-0 items-center gap-2">
          <span
            class="h-[14px] w-[14px] bg-accent"
            style="clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%)"
          ></span>
          <span class="font-ui text-[15px] uppercase tracking-[0.14em] text-text-1">
            {t('app.name')}
          </span>
        </a>

        {user && (
          <nav class="flex items-center gap-0.5">
            {nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'bevel-sm font-ui px-3 py-1.5 text-[13px] uppercase tracking-[0.08em] transition-colors',
                  path === item.href || path.startsWith(`${item.href}/`)
                    ? 'border border-accent bg-accent-weak text-accent-hi'
                    : 'border border-transparent text-text-2 hover:text-text-1',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        )}

        <div class="ml-auto flex items-center gap-2">
          <LanguageSwitcher />
          <ThemeToggle />
          {user ? (
            <>
              <a href="/cuenta" class="flex items-center gap-2 pl-1">
                <HunterAvatar hunter={user} size={26} />
                <span class="hidden font-ui text-[13px] uppercase tracking-wide text-text-2 sm:inline">
                  {user.hunterName ?? user.name}
                  {user.hr && <span class="num ml-1.5 text-text-3">HR {user.hr}</span>}
                </span>
              </a>
              <form method="post" action="/api/auth/logout">
                <button class="font-ui px-2 py-1 text-[12px] uppercase tracking-wide text-text-3 hover:text-text-1">
                  {t('nav.signOut')}
                </button>
              </form>
            </>
          ) : (
            <a
              href="/entrar"
              class="bevel-sm font-ui bg-accent px-3 py-1.5 text-[13px] uppercase tracking-wide text-bg-0 hover:bg-accent-hi"
            >{t('nav.signIn')}</a>
          )}
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-[1360px] flex-1 px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-base-800 px-4 py-4 text-center text-xs text-base-500">
      {t('footer.dataFrom')}
      <a href="https://docs.wilds.mhdb.io/" class="underline hover:text-base-300" rel="noopener">wilds.mhdb.io</a>.
      {t('footer.disclaimer')}
    </footer>
  </body>
</html>
