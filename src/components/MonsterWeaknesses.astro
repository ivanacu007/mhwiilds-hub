---
import type { MonsterAffinity } from '../lib/catalog/types.ts';
import { affinityLabel, splitAffinities } from '../lib/monster-info.ts';

interface Props {
  weaknesses: MonsterAffinity[];
  /** Compacto para la lista; suelto para la ficha de detalle. */
  dense?: boolean;
}

const { weaknesses, dense = false } = Astro.props;
const t = Astro.locals.t;
const split = splitAffinities(weaknesses);

/**
 * Un solo componente para la lista y el detalle: son la misma información y
 * separarlos ya provocó que la lista escondiera las debilidades elementales.
 */
const groups = [
  { key: 'elemental', label: t('monsters.elemental'), list: split.elements, accent: true },
  { key: 'status', label: t('monsters.statuses'), list: split.statuses, accent: false },
  { key: 'effects', label: t('monsters.effects'), list: split.effects, accent: false },
].filter((g) => g.list.length > 0);

const MAX_STARS = 3;
---

{split.elements.length === 0 && (
  <p class:list={[dense ? 'text-xs' : 'text-sm', 'text-base-600']}>{t('monsters.noElemental')}</p>
)}

{groups.map((group) => (
  <div class={dense ? 'mt-1' : 'mb-3'}>
    <h3
      class:list={[
        'uppercase tracking-wide text-base-600',
        dense ? 'text-[10px]' : 'mb-1 text-xs',
      ]}
    >
      {group.label}
    </h3>
    <ul class={dense ? 'space-y-0' : 'space-y-1'}>
      {group.list.map((w) => (
        <li class:list={['flex items-center gap-2', dense ? 'text-xs' : 'text-sm']}>
          <span class:list={['shrink-0', dense ? 'w-24' : 'w-28']}>{affinityLabel(t, w)}</span>
          <span class={group.accent ? 'text-ember-400' : 'text-base-300'}>
            {'★'.repeat(w.level ?? 0)}
            <span class="text-base-700">{'★'.repeat(MAX_STARS - (w.level ?? 0))}</span>
          </span>
          {w.condition && <span class="text-xs text-base-500">({w.condition})</span>}
        </li>
      ))}
    </ul>
  </div>
))}
