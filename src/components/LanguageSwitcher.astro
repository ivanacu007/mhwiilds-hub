---
import { LOCALES, LOCALE_LABEL } from '../lib/i18n/index.ts';

const current = Astro.locals.locale;
const t = Astro.locals.t;

/**
 * Un formulario por idioma en vez de un `select` con JavaScript: así funciona
 * sin scripts y el POST vuelve exactamente a la página donde estabas.
 */
const back = Astro.url.pathname + Astro.url.search;
---

<div class="flex items-center gap-0.5" role="group" aria-label={t('nav.language')}>
  {LOCALES.map((locale) => (
    <form method="post" action="/api/language">
      <input type="hidden" name="lang" value={locale} />
      <input type="hidden" name="back" value={back} />
      <button
        type="submit"
        aria-current={locale === current ? 'true' : undefined}
        title={LOCALE_LABEL[locale]}
        class:list={[
          'rounded px-1.5 py-1 text-xs font-medium uppercase transition-colors',
          locale === current
            ? 'bg-base-800 text-base-100'
            : 'text-base-500 hover:bg-base-850 hover:text-base-300',
        ]}
      >
        {locale}
      </button>
    </form>
  ))}
</div>
