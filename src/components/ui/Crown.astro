---
import { crownSvg } from '../../lib/ui/glyphs.ts';
import type { CrownKey } from '../../lib/crowns.ts';

interface Props {
  crown: CrownKey;
  earned: boolean;
  label?: string;
}
const { crown, earned, label } = Astro.props;
---

<span
  class="inline-flex shrink-0 align-middle"
  title={label}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={crownSvg(crown, earned)}
/>
