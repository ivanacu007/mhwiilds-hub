---
const t = Astro.locals.t;
import Base from '../../layouts/Base.astro';
import { savedSets } from '../../lib/db.ts';
import { getCatalogIndex } from '../../lib/catalog/store.ts';
import { summarizeLoadout } from '../../lib/catalog/loadout.ts';
import { gearIconStyle } from '../../lib/ui/gear-icons.ts';
import { slotSvg } from '../../lib/ui/glyphs.ts';
import SetSockets from '../../components/SetSockets.tsx';
import SkillPanel from '../../components/SkillPanel.tsx';
import { ARMOR_KINDS, type ArmorKind } from '../../lib/catalog/types.ts';

const { slug } = Astro.params;
const user = Astro.locals.user;

const collection = await savedSets();
const set = await collection.findOne({ slug: slug! });

// Un set privado solo existe para su dueño; para el resto es un 404 sin pistas.
if (!set || (!set.isPublic && set.ownerId !== user?.id)) {
  return new Response(Astro.locals.t('sets.notFound'), { status: 404 });
}

// Con el idioma de quien mira: sin él sale el catálogo por defecto y la
// interfaz queda en inglés con los nombres de armadura en español.
const index = await getCatalogIndex(Astro.locals.locale);

const KIND_LABEL: Record<ArmorKind, string> = {
  head: t('piece.head'), chest: t('piece.chest'), arms: t('piece.arms'),
  waist: t('piece.waist'), legs: t('piece.legs'),
};

/** Suma en servidor todo lo que aporta el set, para mostrarlo sin JS. */
const { defense, skills } = summarizeLoadout(index, {
  pieces: Object.fromEntries(ARMOR_KINDS.map((kind) => [kind, set[kind]])),
  weaponId: set.weaponId,
  weaponDecorations: set.weaponDecorations,
  charmId: set.charmId,
  charmLevel: set.charmLevel,
});

const pieces = ARMOR_KINDS.map((kind) => ({
  kind,
  piece: set[kind] ? index.armorById.get(set[kind]!.armorId) ?? null : null,
  decorations: (set[kind]?.decorations ?? [])
    .map((d) => index.decorationById.get(d.decorationId))
    .filter((d) => d != null),
}));

const weapon = set.weaponId != null ? index.weaponById.get(set.weaponId) ?? null : null;
const weaponDecos = set.weaponDecorations
  .map((d) => index.decorationById.get(d.decorationId))
  .filter((d) => d != null);
const charm = set.charmId != null ? index.charmById.get(set.charmId) ?? null : null;

const summary = skills.slice(0, 6).map((s) => `${s.name} ${s.level}`).join(' · ');
const isOwner = user?.id === set.ownerId;
// El nombre de cazador es lo que sus amigos reconocen; el de la app es el respaldo.
const author = set.ownerHunterName || set.ownerName;
---

<Base
  title={`${set.name} · ${t('app.name')}`}
  description={summary}
  ogTitle={`${set.name} — Monster Hunter Wilds`}
  ogDescription={`${t('sets.sharedBy', { name: author })}. ${summary}`}
  noIndex={!set.isPublic}
>
  <article class="mx-auto max-w-5xl">
    <header class="mb-4">
      <h1 class="text-2xl font-semibold">{set.name}</h1>
      <p class="mt-1 text-sm text-text-3">
        {t('sets.sharedBy', { name: author })} · {t('builder.defense')} {defense}
        {!set.isPublic && <span class="ml-2 rounded bg-bg-3 px-1.5 py-0.5 text-xs">{t('sets.private')}</span>}
      </p>
      {set.notes && <p class="mt-2 text-sm text-text-2">{set.notes}</p>}
    </header>

    {/* Al dueño se le da la versión con las ranuras pulsables. Lleva bajarse el
        catálogo, así que a quien abre un enlace compartido para mirar se le
        sirve la de siempre: pintada en el servidor y sin JavaScript. */}
    {isOwner ? (
      <SetSockets
        client:only="preact"
        locale={Astro.locals.locale}
        setId={set._id}
        pieces={Object.fromEntries(ARMOR_KINDS.map((kind) => [kind, set[kind]?.armorId ?? null]))}
        weaponId={set.weaponId}
        charmId={set.charmId}
        charmLevel={set.charmLevel}
        initialSockets={Object.fromEntries([
          ...ARMOR_KINDS.flatMap((kind) =>
            (set[kind]?.decorations ?? []).map((d) => [`${kind}:${d.slotIndex}`, d.decorationId])),
          ...set.weaponDecorations.map((d) => [`weapon:${d.slotIndex}`, d.decorationId]),
        ])}
      />
    ) : (
    <div class="grid items-start gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,340px)]">
      <section class="panel">
        <h2 class="font-ui border-b border-line bg-panel-head px-3 py-1 text-[13px] uppercase tracking-[0.1em] text-text-2">
          {t('sets.equipment')}
        </h2>

        {[
          ...(weapon
            ? [{
                label: t('piece.weapon'), icon: weapon.kind, name: weapon.name,
                slots: weapon.slots, decos: weaponDecos, tone: 'var(--text-2)',
              }]
            : []),
          ...pieces.map(({ kind, piece, decorations }) => ({
            label: KIND_LABEL[kind], icon: kind, name: piece?.name ?? null,
            slots: piece?.slots ?? [], decos: decorations,
            tone: piece ? 'var(--text-2)' : 'var(--text-3)',
          })),
          ...(charm
            ? [{
                label: t('piece.charm'), icon: 'charm', name: `${charm.name} ${set.charmLevel}`,
                slots: [], decos: [], tone: 'var(--crown-gold)',
              }]
            : []),
        ].map((row) => (
          <div class="flex items-center gap-2.5 border-b border-line-soft px-3 py-1.5 last:border-b-0">
            <span class="grid h-[26px] w-[26px] shrink-0 place-items-center border border-line-strong bg-tile">
              <span style={gearIconStyle(row.icon, 16, row.tone)} />
            </span>
            <span class="min-w-0 flex-1">
              {/* El rótulo encima y en pequeño, como en la ficha del juego: la
                  ranura orienta, pero lo que se lee es el nombre de la pieza. */}
              <span class="font-ui block text-[10.5px] uppercase tracking-[0.1em] text-text-3">
                {row.label}
              </span>
              <span class:list={['block truncate text-[14px]', !row.name && 'text-text-3']}>
                {row.name ?? '—'}
              </span>
              {row.decos.length > 0 && (
                <span class="block truncate text-[12px] text-accent-hi">
                  {row.decos.map((d) => d!.name).join(' · ')}
                </span>
              )}
            </span>
            <span class="flex shrink-0 gap-[3px]">
              {row.slots.map((level, i) => (
                <span set:html={slotSvg(level, i < row.decos.length, true)} />
              ))}
            </span>
          </div>
        ))}
      </section>

      {/* El mismo panel que ve el dueño: se le pasan solo las habilidades de
          este set con sus rangos, no el catálogo, así que hidratarlo cuesta
          unos kilobytes y a cambio la ficha de cada habilidad se abre también
          para quien llega por un enlace. */}
      <SkillPanel
        client:load
        locale={Astro.locals.locale}
        title={t('sets.activeSkills')}
        skills={skills.flatMap((s) => {
          const skill = index.skillById.get(s.skillId);
          return skill ? [{ skill, level: s.level, max: s.max }] : [];
        })}
      />
    </div>
    )}

    <div class="mt-6 flex flex-wrap gap-3">
      {user && (
        <a
          href={`/set/${set.slug}/plan`}
          class="rounded border border-line-strong px-4 py-2 font-medium hover:bg-bg-2"
        >{t('plan.open')}</a>
      )}
      {isOwner && (
        <a
          href={`/armador?editar=${set.slug}`}
          class="rounded bg-accent px-4 py-2 font-medium text-bg-0 hover:bg-accent-hi"
        >{t('sets.edit')}</a>
      )}
      {user && !isOwner && (
        <button
          id="clonar"
          data-slug={set.slug}
          data-copying={t('sets.copying')}
          data-failed={t('sets.copyFailed')}
          class="rounded bg-accent px-4 py-2 font-medium text-bg-0 hover:bg-accent-hi"
        >
{t('sets.copyToMine')}</button>
      )}
      {!user && (
        <a href="/entrar" class="rounded border border-line-strong px-4 py-2 hover:bg-bg-2">
{t('sets.signInToCopy')}</a>
      )}
      {isOwner && <a href="/mis-sets" class="rounded border border-line-strong px-4 py-2 hover:bg-bg-2">{t('sets.mySets')}</a>}
    </div>
  </article>
</Base>

<script>
  const button = document.getElementById('clonar');
  button?.addEventListener('click', async () => {
    button.setAttribute('disabled', 'true');
    button.textContent = button.dataset.copying!;
    const res = await fetch('/api/sets/clone', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ slug: button.dataset.slug }),
    });
    if (res.ok) {
      const data = await res.json();
      window.location.href = `/set/${data.slug}`;
    } else {
      button.textContent = button.dataset.failed!;
    }
  });
</script>
