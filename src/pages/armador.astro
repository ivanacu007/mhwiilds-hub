---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import SetBuilder from '../components/SetBuilder.tsx';
---

<Base title={`${t('builder.title')} · ${t('app.name')}`} noIndex>
  <h1 class="mb-1 text-2xl font-semibold">{t('builder.title')}</h1>
  <p class="mb-5 text-sm text-base-500">
    {t('builder.blurb')}
  </p>

  <SetBuilder client:only="preact" locale={Astro.locals.locale} />
</Base>
