---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SetBuilder from '../components/SetBuilder.tsx';
import { getCatalogIndex } from '../lib/catalog/store.ts';

// Las cifras salen del catálogo real, no de constantes que se queden viejas.
const index = await getCatalogIndex(Astro.locals.locale);
const context = t('builder.pageSub', {
  armor: index.catalog.armor.length,
  decos: index.catalog.decorations.length,
  charms: index.catalog.charms.length,
});
---

<Base title={`${t('builder.pageTitle')} · ${t('app.name')}`} noIndex flush>
  <PageHeader title={t('builder.pageTitle')} context={context} />

  <div class="px-4 py-3.5">
    <SetBuilder client:only="preact" locale={Astro.locals.locale} />
  </div>
</Base>
