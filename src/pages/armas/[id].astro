---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SharpnessBar from '../../components/SharpnessBar.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { getCatalogIndex } from '../../lib/catalog/store.ts';
import { gearIconStyle } from '../../lib/ui/gear-icons.ts';
import { slotSvg } from '../../lib/ui/glyphs.ts';
import { itemIconColor, itemIconPath } from '../../lib/catalog/item-icons.ts';
import { effectiveRaw } from '../../lib/builder/weapon-ranking.ts';
import { inventories } from '../../lib/db.ts';
import type { Material } from '../../lib/catalog/types.ts';
import type { TranslationKey } from '../../lib/i18n/index.ts';

const t = Astro.locals.t;
const index = await getCatalogIndex(Astro.locals.locale);

const weapon = index.weaponById.get(Number(Astro.params.id));
if (!weapon) return new Response(t('weapons.notFound'), { status: 404 });

const previous = weapon.crafting?.previousId != null
  ? index.weaponById.get(weapon.crafting.previousId) ?? null
  : null;
const branches = (weapon.crafting?.branchIds ?? [])
  .map((id) => index.weaponById.get(id))
  .filter((w) => w != null);

/**
 * Se mejora desde otra: entonces lo que cuesta es el salto, no forjarla de cero.
 * Enseñar las dos listas confundiría —solo una se paga—, así que se elige.
 */
const isUpgrade = previous != null && (weapon.crafting?.upgradeMaterials.length ?? 0) > 0;
const materials: Material[] = isUpgrade
  ? weapon.crafting!.upgradeMaterials
  : weapon.crafting?.craftMaterials ?? [];
const zenny = isUpgrade ? weapon.crafting!.upgradeZenny : weapon.crafting?.craftZenny ?? 0;

// Lo que ya tienes, si has registrado materiales. Sin sesión no se pregunta.
const owned: Record<string, number> = Astro.locals.user
  ? (await (await inventories()).findOne({ _id: Astro.locals.user.id }))?.materials ?? {}
  : {};

// Con cinturón y tirantes: `fillMissingFields` ya lo garantiza, pero esta
// página fue la que se cayó y no vale la pena que dependa de eso.
const handicraftBonus = weapon.handicraft?.at(-1) ?? 0;
---

<Base title={`${weapon.name} · ${t('app.name')}`} noIndex flush>
  <PageHeader
    title={weapon.name}
    context={`${t(`wk.${weapon.kind}` as TranslationKey)} · r${weapon.rarity}`}
  >
    <a
      slot="actions"
      href={`/armas?tipo=${weapon.kind}`}
      class="font-ui flex h-7 items-center border border-line-strong bg-bg-2 px-3 text-[13px] uppercase tracking-[0.08em] text-text-2 hover:bg-bg-3 hover:text-text-1"
    >{t(`wk.${weapon.kind}` as TranslationKey)}</a>
  </PageHeader>

  <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-3.5">
    <div class="panel bevel-head">
      <header class="flex min-h-[38px] flex-wrap items-center gap-x-4 gap-y-1 border-b border-accent bg-panel-head px-3.5 py-1">
        <span class="grid h-[26px] w-[26px] place-items-center border border-line-strong bg-tile">
          <span style={gearIconStyle(weapon.kind, 16, 'var(--accent-hi)')} />
        </span>
        <span class="flex items-baseline gap-1.5">
          <span class="font-ui text-[11.5px] uppercase tracking-[0.1em] text-text-3">{t('builder.attackShort')}</span>
          <span class="num text-[16px] text-text-1">{weapon.attack}</span>
        </span>
        <span class="flex items-baseline gap-1.5">
          <span class="font-ui text-[11.5px] uppercase tracking-[0.1em] text-text-3">{t('builder.affinityShort')}</span>
          <span class="num text-[15px]" style={weapon.affinity < 0 ? 'color: var(--danger)' : undefined}>
            {weapon.affinity > 0 ? '+' : ''}{weapon.affinity}%
          </span>
        </span>
        {/* Ataque efectivo al lado del bruto: una afinidad negativa se come el
            ataque de más, y verlos juntos es lo que evita el engaño. */}
        <span class="flex items-baseline gap-1.5">
          <span class="font-ui text-[11.5px] uppercase tracking-[0.1em] text-text-3">{t('rank.effective')}</span>
          <span class="num text-[15px] text-accent-hi">{Math.round(effectiveRaw(weapon))}</span>
        </span>
        {weapon.element && (
          <span class="num text-[14px]" style={`color: var(--el-${weapon.element.kind})`}>
            {t(`el.${weapon.element.kind}` as TranslationKey)} {weapon.element.damage}
          </span>
        )}
        <span class="ml-auto flex gap-[3px]">
          {weapon.slots.length > 0
            ? weapon.slots.map((level) => <span set:html={slotSvg(level, false, true)} />)
            : <span class="num text-[12px] text-text-3">{t('builder.noSlots')}</span>}
        </span>
      </header>

      {weapon.sharpness && (
        <div class="flex flex-wrap items-center gap-3 border-b border-line-soft px-3.5 py-2">
          <span class="font-ui text-[11.5px] uppercase tracking-[0.1em] text-text-3">
            {t('weapons.sharpness')}
          </span>
          <SharpnessBar sharpness={weapon.sharpness} handicraft={handicraftBonus} width={260} height={12} />
          {handicraftBonus > 0 && (
            <span class="num text-[11.5px] text-text-3">{t('weapons.handicraft')}</span>
          )}
        </div>
      )}

      {weapon.skills.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 px-3.5 py-2">
          {weapon.skills.map((grant) => (
            <span class="border border-line bg-bg-3 px-2 py-[3px] text-[12.5px] text-text-2">
              {index.skillById.get(grant.skillId)?.name}
              <span class="num ml-1.5 text-[11px] text-accent-hi">{grant.level}</span>
            </span>
          ))}
        </div>
      )}
    </div>

    <SectionHeader
      title={isUpgrade ? t('weapons.upgrade', { name: previous!.name }) : t('weapons.craft')}
      hint={zenny > 0 ? t('weapons.zenny', { n: zenny.toLocaleString() }) : undefined}
    />

    {materials.length === 0 ? (
      <p class="border border-line bg-bg-1 px-3 py-2 text-[13px] text-text-3">
        {weapon.crafting?.craftable ? '—' : t('weapons.notCraftable')}
      </p>
    ) : (
      <ul class="flex flex-col gap-1">
        {materials.map((material) => {
          const item = index.itemById.get(material.itemId);
          const path = itemIconPath(item?.iconKind ?? undefined);
          const color = itemIconColor(item?.iconColor ?? undefined);
          const have = owned[String(material.itemId)] ?? 0;
          const enough = have >= material.quantity;
          return (
            <li class="flex items-center gap-2.5 border border-line bg-bg-1 px-3 py-1.5">
              <span
                class="shrink-0"
                style={path
                  ? `display:inline-block;width:18px;height:18px;background-color:${color};-webkit-mask:url("${path}") center/contain no-repeat;mask:url("${path}") center/contain no-repeat`
                  : `display:inline-block;width:18px;height:18px;border-radius:9px;background:${color};opacity:.45`}
              />
              <span class="min-w-0 flex-1 truncate text-[13.5px]">{item?.name ?? `#${material.itemId}`}</span>
              {/* Solo con sesión: sin inventario registrado, «tienes 0» sería
                  ruido en vez de dato. */}
              {Astro.locals.user && (
                <span
                  class="num text-[12px]"
                  style={enough ? 'color: var(--ok)' : 'color: var(--warn)'}
                >{have}/{material.quantity}</span>
              )}
              {!Astro.locals.user && (
                <span class="num text-[12px] text-text-2">×{material.quantity}</span>
              )}
            </li>
          );
        })}
      </ul>
    )}

    {(previous || branches.length > 0) && (
      <>
        <SectionHeader title={t('weapons.inSeries')} hint={weapon.seriesName ?? undefined} />
        <div class="flex flex-col gap-1">
          {previous && (
            <a
              href={`/armas/${previous.id}`}
              class="flex items-center gap-2 border border-line bg-bg-1 px-3 py-1.5 text-[13.5px] hover:border-accent"
            >
              <span class="font-ui shrink-0 text-[11px] uppercase tracking-[0.1em] text-text-3">
                {t('weapons.comesFrom')}
              </span>
              <span class="min-w-0 truncate">{previous.name}</span>
              <span class="num ml-auto shrink-0 text-[11.5px] text-text-3">
                {t('builder.attackShort')} {previous.attack}
              </span>
            </a>
          )}
          {branches.map((branch) => (
            <a
              href={`/armas/${branch!.id}`}
              class="flex items-center gap-2 border border-line bg-bg-1 px-3 py-1.5 text-[13.5px] hover:border-accent"
            >
              <span class="font-ui shrink-0 text-[11px] uppercase tracking-[0.1em] text-text-3">
                {t('weapons.upgradesTo')}
              </span>
              <span class="min-w-0 truncate">{branch!.name}</span>
              <span class="num ml-auto shrink-0 text-[11.5px] text-text-3">
                {t('builder.attackShort')} {branch!.attack}
              </span>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</Base>
