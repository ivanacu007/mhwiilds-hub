---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import MaterialFinder from '../components/MaterialFinder.tsx';
import { gearIconStyle, maskStyle } from '../lib/ui/gear-icons.ts';
import { crownSvg } from '../lib/ui/glyphs.ts';

const user = Astro.locals.user;

/**
 * Accesos rápidos con el icono del juego, no solo el rótulo: son seis destinos
 * que se reconocen antes por la forma que por el texto, y en una rejilla de
 * rótulos sueltos había que leerlos todos para encontrar el que se buscaba.
 * Se reutilizan las máscaras que ya trae el proyecto; ninguna es nueva.
 */
const material = (slug: string) => maskStyle(`/iconos/materiales/${slug}.webp`, 22, 'var(--accent-hi)');

const quickLinks = [
  { href: '/armador', label: t('builder.title'), icon: gearIconStyle('chest', 22, 'var(--accent-hi)') },
  { href: '/inventario', label: t('nav.inventory'), icon: material('pouch') },
  { href: '/monstruos', label: t('monsters.title'), icon: material('claw') },
  { href: '/armas', label: t('nav.weapons'), icon: gearIconStyle('great-sword', 22, 'var(--accent-hi)') },
  // La corona es glifo propio, no máscara: ya existe con la silueta del juego.
  { href: '/coronas', label: t('nav.crowns'), crown: crownSvg('largeGold', true) },
  { href: '/mis-sets', label: t('nav.mySets'), icon: material('decoration') },
  { href: '/cazadores', label: t('nav.hunters'), icon: material('ticket') },
];
---

<Base
  title={`${t('app.name')} · ${t('app.tagline')}`}
  description={t('home.blurb')}
>
  {user ? (
    <div class="mx-auto max-w-2xl py-6">
      <h1 class="mb-1 text-2xl font-semibold">
        {t('home.welcome', { name: user.hunterName ?? user.name })}
      </h1>

      <section class="mt-5 rounded border border-bg-3 bg-bg-1 p-4">
        <h2 class="text-sm font-medium text-text-2">{t('finder.title')}</h2>
        <p class="mb-3 text-xs text-text-3">{t('finder.blurb')}</p>
        <MaterialFinder client:only="preact" locale={Astro.locals.locale} />
      </section>

      <h2 class="mb-2 mt-6 text-sm font-medium text-text-2">{t('home.quickLinks')}</h2>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="flex items-center gap-2.5 rounded border border-bg-3 bg-bg-1 px-3 py-2.5 text-sm hover:border-accent/50 hover:bg-bg-2"
          >
            {/* Recuadro fijo para el icono: la corona mide distinto que las
                máscaras, y sin caja los rótulos bailaban de fila en fila. */}
            <span class="grid h-6 w-6 shrink-0 place-items-center">
              {link.crown
                ? <span set:html={link.crown} />
                : <span style={link.icon} />}
            </span>
            <span class="min-w-0 truncate">{link.label}</span>
          </a>
        ))}
      </div>
    </div>
  ) : (
  <section class="mx-auto max-w-2xl py-10 text-center">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {t('home.headline')} <span class="text-accent-hi">{t('home.headlineAccent')}</span>
    </h1>
    <p class="mt-4 text-text-2">
      {t('home.blurb')}
    </p>

    <div class="mt-8 flex justify-center gap-3">
      <a href="/entrar" class="rounded bg-accent px-5 py-2.5 font-medium text-bg-0 hover:bg-accent-hi">
{t('nav.signIn')}</a>
      <a href="/registro" class="rounded border border-line-strong px-5 py-2.5 font-medium hover:bg-bg-2">
{t('home.haveInvite')}</a>
    </div>

    <div class="mt-12 grid gap-4 text-left sm:grid-cols-3">
      <div class="rounded border border-bg-3 bg-bg-1 p-4">
        <h2 class="mb-1 font-medium text-accent-hi">{t('home.card1.title')}</h2>
        <p class="text-sm text-text-2">
          {t('home.card1.body')}
        </p>
      </div>
      <div class="rounded border border-bg-3 bg-bg-1 p-4">
        <h2 class="mb-1 font-medium text-accent-hi">{t('home.card2.title')}</h2>
        <p class="text-sm text-text-2">
          {t('home.card2.body')}
        </p>
      </div>
      <div class="rounded border border-bg-3 bg-bg-1 p-4">
        <h2 class="mb-1 font-medium text-accent-hi">{t('home.card3.title')}</h2>
        <p class="text-sm text-text-2">
          {t('home.card3.body')}
        </p>
      </div>
    </div>
  </section>
  )}
</Base>
