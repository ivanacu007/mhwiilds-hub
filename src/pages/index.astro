---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import MaterialFinder from '../components/MaterialFinder.tsx';

const user = Astro.locals.user;
---

<Base
  title={`${t('app.name')} · ${t('app.tagline')}`}
  description={t('home.blurb')}
>
  {user ? (
    <div class="mx-auto max-w-2xl py-6">
      <h1 class="mb-1 text-2xl font-semibold">
        {t('home.welcome', { name: user.hunterName ?? user.name })}
      </h1>

      <section class="mt-5 rounded border border-base-800 bg-base-900 p-4">
        <h2 class="text-sm font-medium text-base-300">{t('finder.title')}</h2>
        <p class="mb-3 text-xs text-base-500">{t('finder.blurb')}</p>
        <MaterialFinder client:only="preact" locale={Astro.locals.locale} />
      </section>

      <h2 class="mb-2 mt-6 text-sm font-medium text-base-300">{t('home.quickLinks')}</h2>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {[
          { href: '/armador', label: t('builder.title') },
          { href: '/inventario', label: t('nav.inventory') },
          { href: '/monstruos', label: t('monsters.title') },
          { href: '/coronas', label: t('nav.crowns') },
          { href: '/mis-sets', label: t('nav.mySets') },
          { href: '/cazadores', label: t('nav.hunters') },
        ].map((link) => (
          <a
            href={link.href}
            class="rounded border border-base-800 bg-base-900 px-3 py-2 text-sm hover:border-ember-500/50 hover:bg-base-850"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  ) : (
  <section class="mx-auto max-w-2xl py-10 text-center">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {t('home.headline')} <span class="text-ember-400">{t('home.headlineAccent')}</span>
    </h1>
    <p class="mt-4 text-base-300">
      {t('home.blurb')}
    </p>

    <div class="mt-8 flex justify-center gap-3">
      <a href="/entrar" class="rounded bg-ember-500 px-5 py-2.5 font-medium text-base-950 hover:bg-ember-400">
{t('nav.signIn')}</a>
      <a href="/registro" class="rounded border border-base-700 px-5 py-2.5 font-medium hover:bg-base-850">
{t('home.haveInvite')}</a>
    </div>

    <div class="mt-12 grid gap-4 text-left sm:grid-cols-3">
      <div class="rounded border border-base-800 bg-base-900 p-4">
        <h2 class="mb-1 font-medium text-ember-300">{t('home.card1.title')}</h2>
        <p class="text-sm text-base-300">
          {t('home.card1.body')}
        </p>
      </div>
      <div class="rounded border border-base-800 bg-base-900 p-4">
        <h2 class="mb-1 font-medium text-ember-300">{t('home.card2.title')}</h2>
        <p class="text-sm text-base-300">
          {t('home.card2.body')}
        </p>
      </div>
      <div class="rounded border border-base-800 bg-base-900 p-4">
        <h2 class="mb-1 font-medium text-ember-300">{t('home.card3.title')}</h2>
        <p class="text-sm text-base-300">
          {t('home.card3.body')}
        </p>
      </div>
    </div>
  </section>
  )}
</Base>
