---
const t = Astro.locals.t;
import { readFlash } from '../lib/flash.ts';
import Base from '../layouts/Base.astro';
import { googleConfigured } from '../lib/auth/google.ts';

if (Astro.locals.user) return Astro.redirect('/');

const params = Astro.url.searchParams;
const error = readFlash(t, params.get('error'));
const email = params.get('email') ?? '';
const name = params.get('name') ?? '';
const invite = params.get('invite') ?? params.get('codigo') ?? '';
const hunterName = params.get('hunterName') ?? '';
const googleReady = googleConfigured();
---

<Base title={`${t('auth.createAccount')} · ${t('app.name')}`} noIndex>
  <div class="mx-auto max-w-sm">
    <h1 class="mb-2 text-2xl font-semibold">{t('auth.createAccount')}</h1>
    <p class="mb-6 text-sm text-text-3">
      {t('auth.inviteOnly')}
    </p>

    {error && (
      <p class="mb-4 rounded border border-red-900 bg-red-950/60 px-3 py-2 text-sm text-red-200">{error}</p>
    )}

    {googleReady && (
      <>
        {/* El código va en la URL: Google no puede pedirlo en su propia pantalla. */}
        <form method="get" action="/api/auth/google" class="space-y-2">
          <input
            name="invite" value={invite} required placeholder={t('auth.inviteCode')}
            class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 font-mono tracking-wider uppercase outline-none focus:border-accent"
          />
          <button class="flex w-full items-center justify-center gap-2 rounded border border-line-strong bg-bg-2 px-4 py-2.5 text-sm font-medium hover:bg-bg-3">
{t('auth.createGoogle')}</button>
        </form>
        <p class="mt-2 text-xs text-text-3">
          {t('auth.googleAfterHint')}
        </p>
        <div class="my-4 flex items-center gap-3 text-xs text-text-3">
          <span class="h-px flex-1 bg-bg-3"></span>{t('auth.orEmail')}<span class="h-px flex-1 bg-bg-3"></span>
        </div>
      </>
    )}

    <form method="post" action="/api/auth/register" class="space-y-3">
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.inviteCode')}</span>
        <input
          name="invite" value={invite} required placeholder="XXXX-XXXX-XXXX"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 font-mono tracking-wider uppercase outline-none focus:border-accent"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.yourName')}</span>
        <input
          name="name" value={name} required minlength="2" maxlength="40" autocomplete="nickname"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">
          {t('account.hunterName')} <span class="text-text-3">{t('account.optional')}</span>
        </span>
        <input
          name="hunterName" value={hunterName} maxlength="40" placeholder={t('account.hunterNamePlaceholder')}
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
        <span class="mt-1 block text-xs text-text-3">
          {t('account.noHunterName')}
        </span>
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.email')}</span>
        <input
          type="email" name="email" value={email} required autocomplete="email"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.password')}</span>
        <input
          type="password" name="password" required minlength="10" autocomplete="new-password"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
        <span class="mt-1 block text-xs text-text-3">{t('auth.passwordHint')}</span>
      </label>
      <button class="w-full rounded bg-accent px-4 py-2.5 font-medium text-bg-0 hover:bg-accent-hi">
{t('auth.createAccount')}</button>
    </form>

    {!googleReady && (
      <p class="mt-4 rounded border border-bg-3 bg-bg-1 px-3 py-2 text-xs text-text-3">
        {t('auth.googleNotConfigured')}
      </p>
    )}

    <p class="mt-6 text-center text-sm text-text-3">
      {t('auth.haveAccountQ')} <a href="/entrar" class="text-accent-hi underline">{t('auth.signInHere')}</a>
    </p>
  </div>
</Base>
