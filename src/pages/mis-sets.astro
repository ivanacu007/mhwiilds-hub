---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Pagination from '../components/Pagination.astro';
import { paginate } from '../lib/paginate.ts';
import { INTL_LOCALE } from '../lib/i18n/index.ts';
import { savedSets } from '../lib/db.ts';
import { getCatalogIndex } from '../lib/catalog/store.ts';
import { summarizeLoadout } from '../lib/catalog/loadout.ts';
import { ARMOR_KINDS } from '../lib/catalog/types.ts';
import { gearIconStyle } from '../lib/ui/gear-icons.ts';
import type { TranslationKey } from '../lib/i18n/index.ts';

const user = Astro.locals.user!;
const collection = await savedSets();

// Se cuenta primero y se pide solo la página: traer 300 documentos para
// mostrar 25 sería tirar trabajo de Mongo y de la red a la basura.
const total = await collection.countDocuments({ ownerId: user.id });
const info = paginate(total, Number(Astro.url.searchParams.get('p') ?? 1), 25);
const sets = await collection
  .find({ ownerId: user.id })
  .sort({ updatedAt: -1 })
  .skip(info.start)
  .limit(info.pageSize)
  .toArray();

const site = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, '');

/**
 * Con el catálogo, para poder decir de qué va cada set.
 *
 * Una lista de nombres no basta: los nombres automáticos son cosas como
 * «Punto débil 5 + Instigador 5», que dicen las habilidades pero no para qué
 * arma es el set ni cuánto aguanta. El arma es lo primero que se busca al
 * repasar la lista, así que va delante, con su icono.
 */
const index = await getCatalogIndex(Astro.locals.locale);

const rows = sets.map((set) => {
  const weapon = set.weaponId != null ? index.weaponById.get(set.weaponId) ?? null : null;
  const summary = summarizeLoadout(index, {
    pieces: Object.fromEntries(ARMOR_KINDS.map((kind) => [kind, set[kind]])),
    weaponId: set.weaponId,
    weaponDecorations: set.weaponDecorations,
    charmId: set.charmId,
    charmLevel: set.charmLevel,
  });
  return {
    set,
    weapon,
    defense: summary.defense,
    pieceCount: summary.pieceCount,
    // Las tres de más nivel: suficientes para reconocer el set sin abrirlo.
    top: summary.skills.slice(0, 3),
  };
});
---

<Base title={`${t('sets.title')} · ${t('app.name')}`} noIndex flush>
  <PageHeader
    title={t('sets.title')}
    context={total === 0
      ? t('sets.empty')
      : total === 1 ? t('sets.countOne') : t('sets.count', { count: total })}
  />

  <div class="px-4 py-3.5">

  <ul
    class="space-y-2"
    data-copied={t('sets.copied')}
    data-error={t('common.error')}
  >
    {rows.map(({ set, weapon, defense, pieceCount, top }) => (
      <li class="flex flex-wrap items-center gap-3 rounded border border-bg-3 bg-bg-1 px-3 py-2.5">
        {/* El arma primero y con su icono: es lo que distingue un set de otro de
            un vistazo, y sin ella la lista eran nombres sueltos. */}
        <span
          class="grid h-[30px] w-[30px] shrink-0 place-items-center border border-line-strong bg-tile"
          title={weapon ? `${t(`wk.${weapon.kind}` as TranslationKey)} · ${weapon.name}` : t('sets.noWeapon')}
        >
          {weapon
            ? <span style={gearIconStyle(weapon.kind, 19, 'var(--accent-hi)')} />
            : <span class="num text-[13px] text-text-3">—</span>}
        </span>

        <div class="min-w-0 flex-1">
          {/* El nombre se edita aquí mismo: nombrar un set es lo que lo hace
              reconocible, y mandar a otra pantalla para cambiar una palabra
              hacía que nadie lo hiciera. */}
          <input
            value={set.name}
            maxlength="60"
            aria-label={t('builder.setName')}
            data-id={set._id}
            class="renombrar w-full min-w-0 truncate border border-transparent bg-transparent px-1 py-0.5 font-medium outline-none hover:border-line focus:border-accent focus:bg-bg-0"
          />
          <p class="px-1 text-xs text-text-3">
            {weapon ? weapon.name : t('sets.noWeapon')}
            {' · '}{t('builder.defense')} {defense}
            {' · '}{t('sets.pieces', { count: pieceCount })}
            {' · '}{new Date(set.updatedAt).toLocaleDateString(INTL_LOCALE[Astro.locals.locale], { day: 'numeric', month: 'short', year: 'numeric' })}
            {!set.isPublic && ` · ${t('sets.private')}`}
            {set.clonedFrom && ` · ${t('sets.cloned')}`}
          </p>
          {top.length > 0 && (
            <p class="truncate px-1 text-xs text-accent-hi">
              {top.map((s) => `${s.name} ${s.level}`).join(' · ')}
            </p>
          )}
        </div>

        <a
          href={`/set/${set.slug}`}
          class="rounded border border-line-strong px-2 py-1 text-xs hover:bg-bg-2"
        >{t('sets.view')}</a>
        <a
          href={`/set/${set.slug}/plan`}
          class="rounded border border-line-strong px-2 py-1 text-xs hover:bg-bg-2"
        >{t('plan.open')}</a>
        <a
          href={`/armador?editar=${set.slug}`}
          class="rounded border border-line-strong px-2 py-1 text-xs hover:bg-bg-2"
        >{t('sets.edit')}</a>
        <button
          class="copiar-enlace rounded border border-line-strong px-2 py-1 text-xs hover:bg-bg-2"
          data-url={`${site}/set/${set.slug}`}
        >
{t('sets.copyLink')}</button>
        <button
          class="borrar rounded border border-line-strong px-2 py-1 text-xs text-text-2 hover:bg-red-950 hover:text-red-200"
          data-id={set._id}
          data-confirm={t('sets.confirmDelete', { name: set.name })}
        >
{t('sets.delete')}</button>
      </li>
    ))}
  </ul>

  <Pagination info={info} label={t('sets.sets')} />
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copiar-enlace')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.url!);
      const original = button.textContent;
      button.textContent = button.closest('ul')?.dataset.copied ?? 'OK';
      setTimeout(() => { button.textContent = original; }, 1500);
    });
  }

  /**
   * Renombrar al salir del campo, y con Enter para quien escribe y sigue.
   * Solo se manda si cambió: pasar por encima de la lista no debería escribir
   * en la base ocho veces.
   */
  for (const input of document.querySelectorAll<HTMLInputElement>('.renombrar')) {
    let saved = input.value;
    const guardar = async () => {
      const name = input.value.trim();
      if (!name || name === saved) {
        input.value = saved;
        return;
      }
      const res = await fetch(`/api/sets/${input.dataset.id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      if (res.ok) {
        saved = name;
        input.value = name;
      } else {
        input.value = saved;
      }
    };
    input.addEventListener('blur', guardar);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') input.blur();
      if (event.key === 'Escape') { input.value = saved; input.blur(); }
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.borrar')) {
    button.addEventListener('click', async () => {
      // confirm() bloquea el hilo pero aquí es lo correcto: borrar no se deshace.
      if (!confirm(button.dataset.confirm!)) return;
      const res = await fetch(`/api/sets/${button.dataset.id}`, { method: 'DELETE' });
      if (res.ok) button.closest('li')?.remove();
      else button.textContent = button.closest('ul')?.dataset.error ?? 'Error';
    });
  }
</script>
