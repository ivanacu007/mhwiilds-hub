---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import { paginate } from '../lib/paginate.ts';
import { savedSets } from '../lib/db.ts';

const user = Astro.locals.user!;
const collection = await savedSets();

// Se cuenta primero y se pide solo la página: traer 300 documentos para
// mostrar 25 sería tirar trabajo de Mongo y de la red a la basura.
const total = await collection.countDocuments({ ownerId: user.id });
const info = paginate(total, Number(Astro.url.searchParams.get('p') ?? 1), 25);
const sets = await collection
  .find({ ownerId: user.id })
  .sort({ updatedAt: -1 })
  .skip(info.start)
  .limit(info.pageSize)
  .toArray();

const site = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/\/$/, '');
---

<Base title="Mis sets · Sets de Wilds" noIndex>
  <h1 class="mb-1 text-2xl font-semibold">Mis sets</h1>
  <p class="mb-5 text-sm text-base-500">
    {total === 0
      ? 'Todavía no guardas ninguno. Ve al armador y guarda el primero.'
      : `${total} ${total === 1 ? 'set guardado' : 'sets guardados'}.`}
  </p>

  <ul class="space-y-2">
    {sets.map((set) => (
      <li class="flex flex-wrap items-center gap-3 rounded border border-base-800 bg-base-900 px-3 py-2.5">
        <div class="min-w-0 flex-1">
          <a href={`/set/${set.slug}`} class="font-medium hover:text-ember-300">{set.name}</a>
          <p class="text-xs text-base-500">
            {new Date(set.updatedAt).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}
            {!set.isPublic && ' · privado'}
            {set.clonedFrom && ' · copiado'}
          </p>
        </div>

        <button
          class="copiar-enlace rounded border border-base-700 px-2 py-1 text-xs hover:bg-base-850"
          data-url={`${site}/set/${set.slug}`}
        >
          Copiar enlace
        </button>
        <button
          class="borrar rounded border border-base-700 px-2 py-1 text-xs text-base-300 hover:bg-red-950 hover:text-red-200"
          data-id={set._id}
          data-name={set.name}
        >
          Borrar
        </button>
      </li>
    ))}
  </ul>

  <Pagination info={info} label="sets" />
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copiar-enlace')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.url!);
      const original = button.textContent;
      button.textContent = '¡Copiado!';
      setTimeout(() => { button.textContent = original; }, 1500);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.borrar')) {
    button.addEventListener('click', async () => {
      // confirm() bloquea el hilo pero aquí es lo correcto: borrar no se deshace.
      if (!confirm(`¿Borrar "${button.dataset.name}"? No se puede deshacer.`)) return;
      const res = await fetch(`/api/sets/${button.dataset.id}`, { method: 'DELETE' });
      if (res.ok) button.closest('li')?.remove();
      else button.textContent = 'Error';
    });
  }
</script>
