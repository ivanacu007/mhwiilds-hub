---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import HunterAvatar from '../components/HunterAvatar.astro';
import Pagination from '../components/Pagination.astro';
import Crown from '../components/ui/Crown.astro';
import { paginate } from '../lib/paginate.ts';
import { getGuild, guildName, listMembers, displayName } from '../lib/guild.ts';
import { getCatalogIndex } from '../lib/catalog/store.ts';
import { progress as progressCollection, savedSets } from '../lib/db.ts';
import { tallyCrowns } from '../lib/crowns.ts';

const guild = await getGuild();
const members = await listMembers();
const index = await getCatalogIndex();
const monsters = index.catalog.monsters;

// Una sola consulta por colección en vez de una por cazador.
const ids = members.map((m) => m.id);
const [progressDocs, setCounts] = await Promise.all([
  (await progressCollection()).find({ _id: { $in: ids } }).toArray(),
  (await savedSets()).aggregate<{ _id: string; count: number }>([
    { $match: { ownerId: { $in: ids } } },
    { $group: { _id: '$ownerId', count: { $sum: 1 } } },
  ]).toArray(),
]);

const progressById = new Map(progressDocs.map((d) => [d._id, d.monsters ?? {}]));
const setsById = new Map(setCounts.map((d) => [d._id, d.count]));

const allRows = members
  .map((member) => ({
    member,
    crowns: tallyCrowns(monsters, progressById.get(member.id) ?? {}),
    sets: setsById.get(member.id) ?? 0,
  }))
  // Se ordena por coronas, que solo se pueden calcular en memoria, así que la
  // página se recorta después de ordenar.
  .sort((a, b) =>
    (b.crowns.largeGold + b.crowns.smallGold) - (a.crowns.largeGold + a.crowns.smallGold) ||
    (b.member.hr ?? 0) - (a.member.hr ?? 0));

const info = paginate(allRows.length, Number(Astro.url.searchParams.get('p') ?? 1), 25);
const rows = allRows.slice(info.start, info.end);
---

<Base title={`${t('hunters.title')} · ${guildName(t, guild)}`} noIndex flush>
  <PageHeader title={t('hunters.title')}>
    <a
      slot="actions"
      href="/gremio"
      class="font-ui flex h-7 items-center border border-line-strong bg-bg-2 px-3 text-[13px] uppercase tracking-[0.08em] text-text-2 hover:bg-bg-3 hover:text-text-1"
    >{guildName(t, guild)}</a>
  </PageHeader>

  <div class="px-4 py-3.5">
  <ul class="space-y-2">
    {rows.map(({ member, crowns, sets }) => (
      <li>
        <a
          href={`/cazador/${member.id}`}
          class="flex flex-wrap items-center gap-x-4 gap-y-1 rounded border border-bg-3 bg-bg-1 px-3 py-2.5 transition-colors hover:border-accent/50 hover:bg-bg-2"
        >
          <HunterAvatar hunter={member} size={40} />
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium">{displayName(member)}</p>
            <p class="text-xs text-text-3">
              {member.hr ? `HR ${member.hr}` : 'sin HR'}
              {member.hunterId && ` · ${member.hunterId}`}
            </p>
          </div>

          <div class="flex items-center gap-3 text-sm">
            {(['largeGold', 'largeSilver', 'smallGold', 'smallSilver'] as const).map((key) => (
              <span class="flex items-center gap-1">
                <Crown crown={key} earned label={t(`crowns.${key}` as never)} />
                <span class="num">{crowns[key]}</span>
              </span>
            ))}
            <span class="text-text-3">{sets} {sets === 1 ? 'set' : 'sets'}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  {allRows.length === 0 && (
    <p class="py-10 text-center text-sm text-text-3">{t('hunters.empty')}</p>
  )}

  <Pagination info={info} label={t('hunters.hunters')} />
  </div>
</Base>
