---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import InventoryEditor from '../components/InventoryEditor.tsx';
---

<Base title={`${t('nav.inventory')} · ${t('app.name')}`} noIndex>
  <PageHeader title={t('inventory.title')} context={t('inventory.blurb')} />

  <div class="px-4 py-3.5">
    <InventoryEditor client:only="preact" locale={Astro.locals.locale} />
  </div>
</Base>
