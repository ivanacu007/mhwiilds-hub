---
import Base from '../layouts/Base.astro';
import { getGuild, listMembers, displayName } from '../lib/guild.ts';

const guild = await getGuild();
const members = await listMembers();
const error = Astro.url.searchParams.get('error');
const aviso = Astro.url.searchParams.get('aviso');

const editor = guild.updatedBy ? members.find((m) => m.id === guild.updatedBy) : null;
---

<Base title={`${guild.name} · Sets de Wilds`} noIndex>
  <div class="mx-auto max-w-lg">
    <h1 class="mb-1 text-2xl font-semibold">{guild.name}</h1>
    {guild.motto && <p class="mb-1 text-sm italic text-base-300">«{guild.motto}»</p>}
    <p class="mb-6 text-sm text-base-500">
      {members.length} {members.length === 1 ? 'cazador' : 'cazadores'}
      {editor && ` · última edición por ${displayName(editor)}`}
    </p>

    {error && (
      <p class="mb-4 rounded border border-red-900 bg-red-950/60 px-3 py-2 text-sm text-red-200">{error}</p>
    )}
    {aviso && (
      <p class="mb-4 rounded border border-jade-500/40 bg-jade-500/10 px-3 py-2 text-sm text-jade-400">{aviso}</p>
    )}

    <form method="post" action="/api/guild" class="space-y-3">
      <label class="block">
        <span class="mb-1 block text-sm text-base-300">Nombre del gremio</span>
        <input
          name="name" value={guild.name} required minlength="2" maxlength="50"
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 outline-none focus:border-ember-500"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-base-300">Lema <span class="text-base-500">(opcional)</span></span>
        <input
          name="motto" value={guild.motto ?? ''} maxlength="140"
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 outline-none focus:border-ember-500"
        />
      </label>
      <button class="w-full rounded bg-ember-500 px-4 py-2.5 font-medium text-base-950 hover:bg-ember-400">
        Guardar
      </button>
      <p class="text-xs text-base-500">
        Cualquier miembro puede cambiarlo. Queda registrado quién fue el último.
      </p>
    </form>

    <a href="/cazadores" class="mt-6 block text-center text-sm text-ember-400 underline">
      Ver a los cazadores
    </a>
  </div>
</Base>
