---
import Base from '../../layouts/Base.astro';
import MonsterIcon from '../../components/MonsterIcon.astro';
import HunterAvatar from '../../components/HunterAvatar.astro';
import Pagination from '../../components/Pagination.astro';
import { paginate } from '../../lib/paginate.ts';
import { getMember, displayName } from '../../lib/guild.ts';
import { getCatalogIndex } from '../../lib/catalog/store.ts';
import { progress as progressCollection, savedSets } from '../../lib/db.ts';
import { CROWN_INFO, CROWN_KEYS, deriveCrowns, formatSize, sumCounts, tallyCrowns, tallyHunts } from '../../lib/crowns.ts';
import { MONSTER_VARIANTS, VARIANT_LABEL } from '../../lib/catalog/monster-icons.ts';
import { SPECIES_LABEL } from '../../lib/monster-art.ts';

const member = await getMember(Astro.params.id!);
if (!member) return new Response('Cazador no encontrado', { status: 404 });

const index = await getCatalogIndex();
const monsters = index.catalog.monsters;

const doc = await (await progressCollection()).findOne({ _id: member.id });
const progress = doc?.monsters ?? {};
const crowns = tallyCrowns(monsters, progress);
const hunts = tallyHunts(progress);

const setsCollection = await savedSets();
const setsTotal = await setsCollection.countDocuments({ ownerId: member.id, isPublic: true });
const setsInfo = paginate(setsTotal, Number(Astro.url.searchParams.get('s') ?? 1), 10);
const sets = await setsCollection
  .find({ ownerId: member.id, isPublic: true })
  .sort({ updatedAt: -1 })
  .skip(setsInfo.start)
  .limit(setsInfo.pageSize)
  .toArray();

const favorites = member.favoriteMonsters
  .map((id) => index.monsterById.get(id))
  .filter((m) => m != null);

// Solo los que tienen alguna corona: la rejilla completa ya vive en /coronas.
const allWithCrowns = monsters
  .map((monster) => ({ monster, state: deriveCrowns(monster, progress[String(monster.id)]) }))
  .filter((row) => CROWN_KEYS.some((key) => row.state[key].earned));

const crownsInfo = paginate(allWithCrowns.length, Number(Astro.url.searchParams.get('c') ?? 1), 24);
const withCrowns = allWithCrowns.slice(crownsInfo.start, crownsInfo.end);

const isMe = Astro.locals.user?.id === member.id;
// El color dice el tipo; la ranura (pequeña o grande) va en la etiqueta.
const TIER_COLOR = { silver: '#c9ccd4', gold: '#e0b53c' } as const;
---

<Base title={`${displayName(member)} · Sets de Wilds`} noIndex>
  <header class="mb-6 flex items-start gap-4">
    <HunterAvatar hunter={member} size={72} />
    <div>
    <h1 class="text-2xl font-semibold">{displayName(member)}</h1>
    <p class="mt-1 text-sm text-base-500">
      {member.hr ? `Hunter Rank ${member.hr}` : 'Sin HR registrado'}
      {member.hunterId && <> · Hunter ID <code class="text-base-300">{member.hunterId}</code></>}
      {member.hunterName && member.hunterName !== member.name && <> · {member.name}</>}
    </p>
    {isMe && (
      <p class="mt-2 text-sm">
        <a href="/cuenta" class="text-ember-400 underline">Editar mi perfil</a>
        <span class="text-base-700"> · </span>
        <a href="/coronas" class="text-ember-400 underline">Registrar coronas</a>
      </p>
    )}
    </div>
  </header>

  <section class="mb-6 grid grid-cols-2 gap-2 sm:grid-cols-5">
    {CROWN_KEYS.map((key) => (
      <div class="rounded border border-base-800 bg-base-900 px-3 py-2">
        <p class="text-xs text-base-500">{CROWN_INFO[key].label}</p>
        <p class="text-lg font-semibold" style={`color:${TIER_COLOR[CROWN_INFO[key].tier]}`}>
          {crowns[key]} <span class="text-sm font-normal text-base-500">/ {crowns.total}</span>
        </p>
      </div>
    ))}
    <div class="rounded border border-base-800 bg-base-900 px-3 py-2">
      <p class="text-xs text-base-500">Completos</p>
      <p class="text-lg font-semibold">
        {crowns.complete} <span class="text-sm font-normal text-base-500">/ {crowns.total}</span>
      </p>
    </div>
  </section>

  {hunts.totalHunted + hunts.totalCaptured > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-sm font-medium text-base-300">Cacerías</h2>
      <div class="overflow-hidden rounded border border-base-800 bg-base-900">
        <div class="flex items-center gap-2 border-b border-base-800 px-3 py-1.5 text-xs text-base-500">
          <span class="flex-1">Nivel</span>
          <span class="w-20 text-right">Cazados</span>
          <span class="w-20 text-right">Capturados</span>
        </div>
        {MONSTER_VARIANTS.filter((v) => hunts.hunted[v] + hunts.captured[v] > 0).map((variant) => (
          <div class="flex items-center gap-2 px-3 py-1.5 text-sm">
            <span class="flex-1">{VARIANT_LABEL[variant]}</span>
            <span class="w-20 text-right">{hunts.hunted[variant]}</span>
            <span class="w-20 text-right">{hunts.captured[variant]}</span>
          </div>
        ))}
        <div class="flex items-center gap-2 border-t border-base-800 px-3 py-1.5 text-sm">
          <span class="flex-1 text-base-500">Total</span>
          <strong class="w-20 text-right">{hunts.totalHunted}</strong>
          <strong class="w-20 text-right">{hunts.totalCaptured}</strong>
        </div>
      </div>
    </section>
  )}

  {favorites.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-sm font-medium text-base-300">Monstruos favoritos</h2>
      <div class="flex flex-wrap gap-2">
        {favorites.map((monster) => (
          <div class="flex w-24 flex-col items-center gap-1 text-center">
            <MonsterIcon monster={monster!} size={64} />
            <span class="text-xs leading-tight text-base-300">{monster!.name}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mb-6">
    <h2 class="mb-2 text-sm font-medium text-base-300">
      Coronas conseguidas
      {allWithCrowns.length > 0 && <span class="text-base-500"> ({allWithCrowns.length})</span>}
    </h2>

    {allWithCrowns.length === 0 ? (
      <p class="rounded border border-base-800 bg-base-900 px-3 py-4 text-center text-sm text-base-500">
        Todavía no registra ninguna corona.
      </p>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(11rem,1fr))] gap-2">
        {withCrowns.map(({ monster, state }) => {
          const p = progress[String(monster.id)];
          return (
            <div class="flex items-center gap-2 rounded border border-base-800 bg-base-900 p-2">
              <MonsterIcon monster={monster} size={44} />
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm">{monster.name}</p>
                <p class="text-[11px] text-base-500">{SPECIES_LABEL[monster.species] ?? monster.species}</p>
                <div class="mt-0.5 flex gap-1">
                  {CROWN_KEYS.map((key) => (
                    <span
                      class="text-xs"
                      style={`color:${TIER_COLOR[CROWN_INFO[key].tier]};opacity:${state[key].earned ? 1 : 0.2}`}
                      title={`${CROWN_INFO[key].label} · ${state[key].fromSize ? 'confirmada por tamaño' : 'marcada a mano'}`}
                    >{CROWN_INFO[key].slot === 'small' ? '♙' : '♔'}</span>
                  ))}
                  {p?.largest != null && (
                    <span class="ml-1 text-[11px] text-base-500">máx {formatSize(p.largest)}</span>
                  )}
                  {sumCounts(p?.hunted) > 0 && (
                    <span class="ml-1 text-[11px] text-base-500">· {sumCounts(p?.hunted)} cazados</span>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <Pagination info={crownsInfo} param="c" label="monstruos" />
  </section>

  <section>
    <h2 class="mb-2 text-sm font-medium text-base-300">Sets compartidos</h2>
    {setsTotal === 0 ? (
      <p class="rounded border border-base-800 bg-base-900 px-3 py-4 text-center text-sm text-base-500">
        No tiene sets públicos.
      </p>
    ) : (
      <ul class="space-y-1">
        {sets.map((set) => (
          <li>
            <a
              href={`/set/${set.slug}`}
              class="block rounded border border-base-800 bg-base-900 px-3 py-2 text-sm hover:border-ember-500/50 hover:bg-base-850"
            >
              {set.name}
            </a>
          </li>
        ))}
      </ul>
    )}

    <Pagination info={setsInfo} param="s" label="sets" />
  </section>
</Base>
