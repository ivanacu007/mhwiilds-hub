---
const t = Astro.locals.t;
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import MonsterIcon from '../../components/MonsterIcon.astro';
import HunterAvatar from '../../components/HunterAvatar.astro';
import Crown from '../../components/ui/Crown.astro';
import Pagination from '../../components/Pagination.astro';
import { paginate } from '../../lib/paginate.ts';
import { getMember, displayName } from '../../lib/guild.ts';
import { getCatalogIndex } from '../../lib/catalog/store.ts';
import { progress as progressCollection, savedSets } from '../../lib/db.ts';
import { CROWN_KEYS, crownsOf, sumCounts, tallyCrowns, tallyHunts } from '../../lib/crowns.ts';
import { MONSTER_VARIANTS } from '../../lib/catalog/monster-icons.ts';

const member = await getMember(Astro.params.id!);
if (!member) return new Response(Astro.locals.t('profile.notFound'), { status: 404 });

const index = await getCatalogIndex();
const monsters = index.catalog.monsters;

const doc = await (await progressCollection()).findOne({ _id: member.id });
const progress = doc?.monsters ?? {};
const crowns = tallyCrowns(monsters, progress);
const hunts = tallyHunts(progress);

const setsCollection = await savedSets();
const setsTotal = await setsCollection.countDocuments({ ownerId: member.id, isPublic: true });
const setsInfo = paginate(setsTotal, Number(Astro.url.searchParams.get('s') ?? 1), 10);
const sets = await setsCollection
  .find({ ownerId: member.id, isPublic: true })
  .sort({ updatedAt: -1 })
  .skip(setsInfo.start)
  .limit(setsInfo.pageSize)
  .toArray();

const favorites = member.favoriteMonsters
  .map((id) => index.monsterById.get(id))
  .filter((m) => m != null);

// Solo los que tienen alguna corona: la rejilla completa ya vive en /coronas.
const allWithCrowns = monsters
  .map((monster) => ({ monster, state: crownsOf(progress[String(monster.id)]) }))
  .filter((row) => CROWN_KEYS.some((key) => row.state[key]));

const crownsInfo = paginate(allWithCrowns.length, Number(Astro.url.searchParams.get('c') ?? 1), 24);
const withCrowns = allWithCrowns.slice(crownsInfo.start, crownsInfo.end);

const isMe = Astro.locals.user?.id === member.id;
---

<Base title={`${displayName(member)} · ${t('app.name')}`} noIndex flush>
  <PageHeader title={t('hunters.title')} />

  <div class="px-4 py-3.5">
  <header class="mb-6 flex items-start gap-4">
    <HunterAvatar hunter={member} size={72} />
    <div>
    <h1 class="text-2xl font-semibold">{displayName(member)}</h1>
    <p class="mt-1 text-sm text-text-3">
      {member.hr ? t('profile.hunterRank', { hr: member.hr }) : t('profile.noHr')}
      {member.hunterId && <> · Hunter ID <code class="text-text-2">{member.hunterId}</code></>}
      {member.hunterName && member.hunterName !== member.name && <> · {member.name}</>}
    </p>
    {isMe && (
      <p class="mt-2 text-sm">
        <a href="/cuenta" class="text-accent-hi underline">{t('account.editProfileShort')}</a>
        <span class="text-line-strong"> · </span>
        <a href="/coronas" class="text-accent-hi underline">{t('profile.recordCrowns')}</a>
      </p>
    )}
    </div>
  </header>

  <section class="mb-6 grid grid-cols-2 gap-2 sm:grid-cols-5">
    {CROWN_KEYS.map((key) => (
      <div class="rounded border border-bg-3 bg-bg-1 px-3 py-2">
        <p class="flex items-center gap-1.5 text-xs text-text-3">
          <Crown crown={key} earned />
          {t(`crowns.${key}` as any)}
        </p>
        <p class="num text-lg font-semibold">
          {crowns[key]} <span class="text-sm font-normal text-text-3">/ {crowns.total}</span>
        </p>
      </div>
    ))}
    <div class="rounded border border-bg-3 bg-bg-1 px-3 py-2">
      <p class="text-xs text-text-3">{t('profile.completeCrowns')}</p>
      <p class="text-lg font-semibold">
        {crowns.complete} <span class="text-sm font-normal text-text-3">/ {crowns.total}</span>
      </p>
    </div>
  </section>

  {hunts.totalHunted + hunts.totalCaptured > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-sm font-medium text-text-2">{t('profile.hunts')}</h2>
      <div class="overflow-hidden rounded border border-bg-3 bg-bg-1">
        <div class="flex items-center gap-2 border-b border-bg-3 px-3 py-1.5 text-xs text-text-3">
          <span class="flex-1">{t('crowns.level')}</span>
          <span class="w-20 text-right">{t('crowns.hunted')}</span>
          <span class="w-20 text-right">{t('crowns.captured')}</span>
        </div>
        {MONSTER_VARIANTS.filter((v) => hunts.hunted[v] + hunts.captured[v] > 0).map((variant) => (
          <div class="flex items-center gap-2 px-3 py-1.5 text-sm">
            <span class="flex-1">{t(`variant.${variant}` as any)}</span>
            <span class="w-20 text-right">{hunts.hunted[variant]}</span>
            <span class="w-20 text-right">{hunts.captured[variant]}</span>
          </div>
        ))}
        <div class="flex items-center gap-2 border-t border-bg-3 px-3 py-1.5 text-sm">
          <span class="flex-1 text-text-3">{t('crowns.total')}</span>
          <strong class="w-20 text-right">{hunts.totalHunted}</strong>
          <strong class="w-20 text-right">{hunts.totalCaptured}</strong>
        </div>
      </div>
    </section>
  )}

  {favorites.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-sm font-medium text-text-2">{t('profile.favorites')}</h2>
      <div class="flex flex-wrap gap-2">
        {favorites.map((monster) => (
          <div class="flex w-24 flex-col items-center gap-1 text-center">
            <MonsterIcon monster={monster!} size={64} />
            <span class="text-xs leading-tight text-text-2">{monster!.name}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mb-6">
    <h2 class="mb-2 text-sm font-medium text-text-2">
      {t('profile.crownsEarned')}
      {allWithCrowns.length > 0 && <span class="text-text-3"> ({allWithCrowns.length})</span>}
    </h2>

    {allWithCrowns.length === 0 ? (
      <p class="rounded border border-bg-3 bg-bg-1 px-3 py-4 text-center text-sm text-text-3">
        {t('profile.noCrowns')}
      </p>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(11rem,1fr))] gap-2">
        {withCrowns.map(({ monster, state }) => {
          const p = progress[String(monster.id)];
          return (
            <div class="flex items-center gap-2 rounded border border-bg-3 bg-bg-1 p-2">
              <MonsterIcon monster={monster} size={44} />
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm">{monster.name}</p>
                <p class="text-[11px] text-text-3">{t(`species.${monster.species}` as any)}</p>
                <div class="mt-0.5 flex gap-1">
                  {CROWN_KEYS.map((key) => (
                    <Crown crown={key} earned={state[key]} label={t(`crowns.${key}` as any)} />
                  ))}
                  {sumCounts(p?.hunted) > 0 && (
                    <span class="ml-1 text-[11px] text-text-3">· {sumCounts(p?.hunted)} {t('crowns.hunted').toLowerCase()}</span>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <Pagination info={crownsInfo} param="c" label={t('crowns.monsters')} />
  </section>

  <section>
    <h2 class="mb-2 text-sm font-medium text-text-2">{t('profile.sharedSets')}</h2>
    {setsTotal === 0 ? (
      <p class="rounded border border-bg-3 bg-bg-1 px-3 py-4 text-center text-sm text-text-3">
        {t('profile.noPublicSets')}
      </p>
    ) : (
      <ul class="space-y-1">
        {sets.map((set) => (
          <li>
            <a
              href={`/set/${set.slug}`}
              class="block rounded border border-bg-3 bg-bg-1 px-3 py-2 text-sm hover:border-accent/50 hover:bg-bg-2"
            >
              {set.name}
            </a>
          </li>
        ))}
      </ul>
    )}

    <Pagination info={setsInfo} param="s" label={t('sets.sets')} />
  </section>
  </div>
</Base>
