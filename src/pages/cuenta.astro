---
import Base from '../layouts/Base.astro';

const user = Astro.locals.user!;
const error = Astro.url.searchParams.get('error');
const aviso = Astro.url.searchParams.get('aviso');
---

<Base title="Mi cuenta · Sets de Wilds" noIndex>
  <div class="mx-auto max-w-sm">
    <h1 class="mb-6 text-2xl font-semibold">Mi cuenta</h1>

    {error && (
      <p class="mb-4 rounded border border-red-900 bg-red-950/60 px-3 py-2 text-sm text-red-200">{error}</p>
    )}
    {aviso && (
      <p class="mb-4 rounded border border-jade-500/40 bg-jade-500/10 px-3 py-2 text-sm text-jade-400">{aviso}</p>
    )}

    {!user.hunterName && (
      <p class="mb-4 rounded border border-ember-500/40 bg-ember-500/5 px-3 py-2 text-sm text-base-300">
        Todavía no pones tu Hunter Name. Es el que ven tus amigos en tu perfil y en los sets que compartas.
      </p>
    )}

    <form method="post" action="/api/auth/profile" class="space-y-3">
      <label class="block">
        <span class="mb-1 block text-sm text-base-300">Cómo te llamas</span>
        <input
          name="name" value={user.name} required minlength="2" maxlength="40"
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 outline-none focus:border-ember-500"
        />
      </label>

      <label class="block">
        <span class="mb-1 block text-sm text-base-300">
          Hunter Name <span class="text-base-500">(opcional)</span>
        </span>
        <input
          name="hunterName" value={user.hunterName ?? ''} maxlength="40"
          placeholder="Tu nombre dentro de Wilds"
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 outline-none focus:border-ember-500"
        />
      </label>

      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="mb-1 block text-sm text-base-300">
            Hunter ID <span class="text-base-500">(opcional)</span>
          </span>
          <input
            name="hunterId" value={user.hunterId ?? ''} maxlength="30" placeholder="Tu código"
            class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 font-mono text-sm outline-none focus:border-ember-500"
          />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm text-base-300">
            HR <span class="text-base-500">(opcional)</span>
          </span>
          <input
            type="number" name="hr" value={user.hr ?? ''} min="1" max="999" placeholder="—"
            class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 outline-none focus:border-ember-500"
          />
        </label>
      </div>

      <button class="w-full rounded bg-ember-500 px-4 py-2.5 font-medium text-base-950 hover:bg-ember-400">
        Guardar
      </button>
    </form>

    <p class="mt-4 text-center text-sm">
      <a href={`/cazador/${user.id}`} class="text-ember-400 underline">Ver mi perfil público</a>
    </p>

    <dl class="mt-8 space-y-2 border-t border-base-800 pt-6 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-base-500">Correo</dt>
        <dd class="truncate">{user.email}</dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-base-500">Acceso</dt>
        <dd>
          {user.hasPassword ? 'Correo y contraseña' : 'Google'}
        </dd>
      </div>
    </dl>
  </div>
</Base>
