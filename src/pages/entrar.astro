---
const t = Astro.locals.t;
import { readFlash } from '../lib/flash.ts';
import Base from '../layouts/Base.astro';
import { googleConfigured } from '../lib/auth/google.ts';
import { emailConfigured } from '../lib/auth/email.ts';

if (Astro.locals.user) return Astro.redirect('/armador');

const error = readFlash(t, Astro.url.searchParams.get('error'));
const aviso = readFlash(t, Astro.url.searchParams.get('aviso'));
const email = Astro.url.searchParams.get('email') ?? '';
const siguiente = Astro.url.searchParams.get('siguiente') ?? '';
---

<Base title={`${t('auth.signIn')} · ${t('app.name')}`} noIndex>
  <div class="mx-auto max-w-sm">
    <h1 class="mb-6 text-2xl font-semibold">{t('auth.signIn')}</h1>

    {error && (
      <p class="mb-4 rounded border border-red-900 bg-red-950/60 px-3 py-2 text-sm text-red-200">{error}</p>
    )}
    {aviso && (
      <p class="mb-4 rounded border border-line-strong bg-bg-2 px-3 py-2 text-sm text-text-2">{aviso}</p>
    )}

    {googleConfigured() && (
      <>
        <a
          href="/api/auth/google"
          class="mb-4 flex w-full items-center justify-center gap-2 rounded border border-line-strong bg-bg-2 px-4 py-2.5 text-sm font-medium hover:bg-bg-3"
        >
{t('auth.continueGoogle')}</a>
        <div class="mb-4 flex items-center gap-3 text-xs text-text-3">
          <span class="h-px flex-1 bg-bg-3"></span>{t('auth.orEmail')}<span class="h-px flex-1 bg-bg-3"></span>
        </div>
      </>
    )}

    <form method="post" action="/api/auth/login" class="space-y-3">
      <input type="hidden" name="siguiente" value={siguiente} />
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.email')}</span>
        <input
          type="email" name="email" value={email} required autocomplete="email"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm text-text-2">{t('auth.password')}</span>
        <input
          type="password" name="password" required autocomplete="current-password"
          class="w-full rounded border border-line-strong bg-bg-1 px-3 py-2 outline-none focus:border-accent"
        />
      </label>
      <button class="w-full rounded bg-accent px-4 py-2.5 font-medium text-bg-0 hover:bg-accent-hi">
{t('auth.signIn')}</button>
    </form>

    {emailConfigured() && (
      <details class="mt-4">
        <summary class="cursor-pointer text-sm text-text-3 hover:text-text-2">{t('auth.forgot')}</summary>
        <form method="post" action="/api/auth/forgot" class="mt-2 flex gap-2">
          <input
            type="email" name="email" placeholder="tu@correo.com" required
            class="flex-1 rounded border border-line-strong bg-bg-1 px-3 py-2 text-sm outline-none focus:border-accent"
          />
          <button class="rounded border border-line-strong px-3 py-2 text-sm hover:bg-bg-2">{t('auth.send')}</button>
        </form>
      </details>
    )}

    <p class="mt-6 text-center text-sm text-text-3">
      {t('auth.haveInviteQ')} <a href="/registro" class="text-accent-hi underline">{t('auth.createYours')}</a>
    </p>
  </div>
</Base>
