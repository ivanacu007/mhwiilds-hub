---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import CrownTracker from '../components/CrownTracker.tsx';

const user = Astro.locals.user!;
---

<Base title={`${t('crowns.title')} · ${t('app.name')}`} noIndex>
  <h1 class="mb-1 text-2xl font-semibold">{t('crowns.title')}</h1>
  <p class="mb-5 text-sm text-base-500">
    {t('crowns.blurb')}
  </p>

  <CrownTracker client:only="preact" favorites={user.favoriteMonsters} locale={Astro.locals.locale} />
</Base>
