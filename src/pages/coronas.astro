---
const t = Astro.locals.t;
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CrownTracker from '../components/CrownTracker.tsx';

const user = Astro.locals.user!;
---

<Base title={`${t('crowns.title')} · ${t('app.name')}`} noIndex>
  <PageHeader title={t('crowns.title')} context={t('crowns.blurb')} />

  <div class="px-4 py-3.5">
    <CrownTracker client:only="preact" favorites={user.favoriteMonsters} locale={Astro.locals.locale} />
  </div>
</Base>
