---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import MonsterIcon from '../../components/MonsterIcon.astro';
import { getCatalogIndex } from '../../lib/catalog/store.ts';
import MonsterWeaknesses from '../../components/MonsterWeaknesses.astro';

const t = Astro.locals.t;
const index = await getCatalogIndex(Astro.locals.locale);

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = query
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase();

const matching = index.catalog.monsters.filter(
  (m) => !needle || m.name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().includes(needle),
);

// Sin paginar: son 34 y el sentido de la pantalla es verlos todos de un vistazo.
const monsters = matching;
---

<Base title={`${t('monsters.title')} · ${t('app.name')}`} noIndex flush>
  <PageHeader
    title={t('monsters.title')}
    context={t('monsters.blurb')}
  >
    {/* Búsqueda por GET: la página es de servidor y así el resultado se comparte. */}
    <form method="get" slot="actions" class="flex gap-1.5">
      <input
        name="q"
        value={query}
        placeholder={t('monsters.search')}
        class="h-7 min-w-0 border border-line-strong bg-bg-0 px-2 text-[13px] outline-none focus:border-accent"
      />
      <button class="font-ui flex h-7 items-center border border-line-strong bg-bg-2 px-3 text-[13px] uppercase tracking-[0.08em] text-text-2 hover:bg-bg-3 hover:text-text-1">
        {t('monsters.search').replace('…', '')}
      </button>
    </form>
  </PageHeader>

  <div class="px-4 py-3.5">

  {/* auto-fill con mínimo de 232 px: la tarjeta manda sobre el número de
      columnas, así el bloque de debilidades nunca se estrangula. */}
  <ul class="grid gap-2 [grid-template-columns:repeat(auto-fill,minmax(232px,1fr))]">
    {monsters.map((monster) => (
      <li>
        <a
          href={`/monstruos/${monster.id}`}
          class="bevel-sm flex h-full items-start gap-3 border border-line bg-bg-1 p-2 transition-colors hover:border-accent"
        >
          <MonsterIcon monster={monster} size={56} class="tile" />
          <div class="min-w-0 flex-1">
            <p class="font-guide text-[17px] leading-tight">{monster.name}</p>
            <p class="truncate font-ui text-[11px] uppercase tracking-wide text-text-3">
              {t(`species.${monster.species}` as never)}
            </p>
            <MonsterWeaknesses weaknesses={monster.weaknesses} resistances={monster.resistances} dense />
          </div>
        </a>
      </li>
    ))}
  </ul>

  {matching.length === 0 && (
    <p class="py-10 text-center text-sm text-text-3">{t('monsters.noneMatch')}</p>
  )}


    {/* Esta lista no se pagina, pero sí lleva el recuento al pie: es la única
        pantalla donde se ve el bestiario entero de una pasada. */}
    {monsters.length > 0 && (
      <p class="num mt-4 text-xs text-text-3">
        {t('pagination.only', { total: monsters.length, label: t('monsters.monsters') })}
      </p>
    )}
  </div>
</Base>
