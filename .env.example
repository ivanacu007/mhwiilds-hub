# --- Base de datos (instancia Mongo que ya corre en el VPS) ---
MONGODB_URI=mongodb://usuario:password@mongo:27017/?authSource=admin
MONGODB_DB=mhwilds_sets

# --- Sesiones ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- URL pública (necesaria para el callback de Google y los links compartidos) ---
PUBLIC_SITE_URL=https://sets.tudominio.com

# --- Google OAuth ---
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web)
# Authorized redirect URI: {PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (opcional: solo para reset de contraseña) ---
# Si se deja vacío, el reset se deshabilita y la app manda a entrar con Google.
RESEND_API_KEY=
RESEND_FROM="MH Wilds Sets <sets@tudominio.com>"

# --- Catálogo ---
# Locale de wilds.mhdb.io a sincronizar.
# OJO: "es" es el español de España y "es-419" el latino, y difieren bastante
# (el 100% de los adornos, la mitad de las armaduras). Los nombres que muestra
# el juego en México son los de es-419.
# Déjala vacía para sincronizar todos los idiomas de la interfaz.
CATALOG_LOCALE=

# --- Iconos de monstruo (opcional) ---
# public/monstruos/ está en .gitignore, así que los iconos no viajan en la imagen
# de Docker. Apunta esto a un volumen de Dokploy donde los subas una vez y
# sobrevivan a cada deploy. Si se deja vacío, se sirven desde public/monstruos/.
MONSTER_ICONS_DIR=
